# Backend Environment Variables

# Allowed CORS origins (comma-separated)
# For local development: http://localhost:3000
# For production, add your frontend URL(s)
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Frontend URL (optional, for production)
# Set this to your deployed frontend URL
# FRONTEND_URL=https://your-frontend.vercel.app

# Render automatically sets RENDER_EXTERNAL_URL, no need to set manually
# RENDER_EXTERNAL_URL is automatically added to allowed origins

